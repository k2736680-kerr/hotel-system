{
  "name": "hotel-crm-local",
  "version": "1.4.1",
  "description": "酒店管家——单机离线酒店前台管理系统",
  "main": "main.js",
  "author": "Hotel System",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "rebuild": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "element-plus": "2.14.2",
    "sql.js": "1.13.0",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.local.hotelmanager",
    "productName": "酒店管家",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "node_modules/vue/dist/vue.global.prod.js",
      "node_modules/element-plus/dist/**/*",
      "node_modules/sql.js/dist/**/*",
      "node_modules/sql.js/package.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HotelButler-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
